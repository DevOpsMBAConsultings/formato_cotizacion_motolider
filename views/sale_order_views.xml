<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_motolider" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.motolider</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add sum attribute to product_uom_qty column in order_line grid -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="attributes">
                <attribute name="sum">Total Unidades</attribute>
            </xpath>
            <!-- Add total_qty field before tax_totals in the footer totals section -->
            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="total_qty" readonly="1" string="Total Unidades"/>
            </xpath>
        </field>
    </record>
</odoo>
